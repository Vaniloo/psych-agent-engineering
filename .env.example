MYSQL_DATABASE=psych_agent
MYSQL_USERNAME=psych_agent
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_URL="jdbc:mysql://localhost:3306/psych_agent?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CHROMA_HOST=http://localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=psych-agent-knowledge-v2
LEGACY_CHROMA_COLLECTION=psych-agent-knowledge-legacy
OLLAMA_BASE_URL=http://localhost:11434
JWT_SECRET=replace-with-at-least-32-random-characters
MAIL_USERNAME=
MAIL_PASSWORD=
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_THINK=false
INTERNAL_SERVICE_TOKEN=replace-with-an-independent-random-service-token
BACKEND_BASE_URL=http://localhost:8080
# rules | laya | qwen; router, executor and memory have separate checkpoints
ROUTER_PROVIDER=rules
ROUTER_BASE_URL=http://localhost:8091
ROUTER_API_KEY=
ROUTER_TIMEOUT_SECONDS=3
ROUTER_MIN_PROBABILITY=0.85
CONTEXT_WINDOW_TOKENS=8192
RESPONSE_RESERVE_TOKENS=1200
RAG_LLM_RERANK_ENABLED=false
MODEL_COST_MODE=local
INPUT_COST_PER_MILLION_TOKENS=0
OUTPUT_COST_PER_MILLION_TOKENS=0

# Optional local models; rules mode keeps the architecture usable before training.
EXECUTOR_PROVIDER=rules
EXECUTOR_BASE_URL=http://localhost:8093
EXECUTOR_API_KEY=
EXECUTOR_MIN_PROBABILITY=0.85
# Optional task split: empty inherits Executor; goal worker only judges owned goals.
EXECUTOR_GOAL_PROVIDER=
EXECUTOR_GOAL_BASE_URL=
EXECUTOR_GOAL_API_KEY=
EXECUTOR_GOAL_TIMEOUT_SECONDS=2
EXECUTOR_GOAL_MIN_PROBABILITY=0.85
MEMORY_PROVIDER=rules
# Match the checkpoint; current Qwen Memory requires psych-memory-v4.
MEMORY_CONTRACT_VERSION=psych-memory-v2
MEMORY_BASE_URL=http://localhost:8092
MEMORY_API_KEY=
MEMORY_MIN_PROBABILITY=0.85
MEMORY_STORE_PATH=data/memory.sqlite3
# Experimental lifecycle preview; both URL and an explicit user allowlist are required.
# Existing retrieval and formal memory writes stay on the frozen model.
MEMORY_LIFECYCLE_SHADOW_URL=
MEMORY_LIFECYCLE_SHADOW_KEY=
MEMORY_LIFECYCLE_SHADOW_USERS=
# Optional projection into the separate experimental ledger, never formal retrieval.
# Explicit subset of SHADOW_USERS; keep empty outside dedicated synthetic accounts.
MEMORY_LIFECYCLE_SANDBOX_USERS=
MEMORY_LIFECYCLE_STORE_PATH=data/memory-lifecycle.sqlite3
# Optional original 0.6B reranker; Qwen Memory requires the v4 contract.
MEMORY_RERANK_BASE_URL=
MEMORY_RERANK_API_KEY=
MEMORY_RERANK_TIMEOUT_SECONDS=2
# Qwen only: bounded recent-source expansion, 0 disables it.
MEMORY_RECALL_RECENT_LIMIT=24
# Relevant context from other conversations when the current session is thin.
MEMORY_CONTEXT_RECALL_ENABLED=true
TOOL_TRANSPORT=local

# Generation provider; local Laya decisions and embeddings are independent.
AI_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Match public chat admission to measured model capacity; keep overload queues short.
AGENT_STREAM_CONCURRENCY=4
AGENT_STREAM_QUEUE_CAPACITY=4

# Agent loop: read phase deadline; one optional structured query recovery.
AGENT_LOOP_TIMEOUT_SECONDS=35
AGENT_LOOP_REFINEMENT_ENABLED=true

# Personal recall: user-facing day boundary and legacy naive observation timestamps.
MEMORY_QUERY_TIMEZONE=Asia/Shanghai
MEMORY_LEGACY_TIMEZONE=UTC
