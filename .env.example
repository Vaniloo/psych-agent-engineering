MYSQL_DATABASE=psych_agent
MYSQL_USERNAME=psych_agent
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_URL="jdbc:mysql://localhost:3306/psych_agent?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CHROMA_HOST=http://localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=psych-agent-knowledge-v2
LEGACY_CHROMA_COLLECTION=psych-agent-knowledge-legacy
OLLAMA_BASE_URL=http://localhost:11434
JWT_SECRET=replace-with-at-least-32-random-characters
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_THINK=false
INTERNAL_SERVICE_TOKEN=replace-with-an-independent-random-service-token
BACKEND_BASE_URL=http://localhost:8080
CONTEXT_WINDOW_TOKENS=8192
RESPONSE_RESERVE_TOKENS=1200
# Optional independent knowledge reranker; never point this at the Memory task.
# Agent-loop query planning and evidence grading; at most two knowledge reads.
AGENTIC_RAG_ENABLED=false
AGENTIC_RAG_MODEL_TIMEOUT_SECONDS=5
AGENTIC_RAG_TIMEOUT_SECONDS=15
MODEL_COST_MODE=local
INPUT_COST_PER_MILLION_TOKENS=0
OUTPUT_COST_PER_MILLION_TOKENS=0

# ToolACE GPU worker; use rules for local offline development.
EXECUTOR_PROVIDER=public_qwen
EXECUTOR_ADAPTER_SHA256=5c526403a928b637774d7e1304a49fa3979224dad3ce5e8437b37d1bdc4f04a7
EXECUTOR_BASE_URL=http://host.docker.internal:8093
EXECUTOR_API_KEY=
# Existing JEV write-time labels diversify candidates; no query classifier or extra model call.
MEMORY_STORE_PATH=data/memory.sqlite3
# Relevant context from other conversations when the current session is thin.
MEMORY_CONTEXT_RECALL_ENABLED=true
TOOL_TRANSPORT=local
# Host-owned manifest for individually granted, read-only MCP tools. Empty disables discovery.
# Names are namespaced; routes/identity bindings/account scope are supplied by the host.

AI_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Match public chat admission to measured model capacity; keep overload queues short.
AGENT_STREAM_CONCURRENCY=4
AGENT_STREAM_QUEUE_CAPACITY=4

# Agent loop: read phase deadline; one optional structured query recovery.
AGENT_LOOP_MAX_TOOL_CALLS=8
AGENT_LOOP_TIMEOUT_SECONDS=60
AGENT_LOOP_REFINEMENT_ENABLED=true

# Personal recall: user-facing day boundary and legacy naive observation timestamps.
MEMORY_QUERY_TIMEZONE=Asia/Shanghai
MEMORY_LEGACY_TIMEZONE=UTC

# Local development voice-card studio; keep off for the normal application.
ROLE_STUDIO_ENABLED=false
ROLE_STUDIO_USERS=

# Experimental generic web search. HTML provider is a development adapter, without an SLA.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_USERS=
WEB_SEARCH_PROACTIVE_ENABLED=false
WEB_SEARCH_BASE_URL=http://searxng:8080
WEB_SEARCH_ENGINES=360search,yandex
WEB_SEARCH_FALLBACK_ENGINES=naver,mwmbl
WEB_PROVIDER_TIMEOUT_SECONDS=6
WEB_SEARCH_CACHE_DIR=data/web-search-cache

# Base64-encoded 32-byte key for encrypting per-account model API credentials.
# Generate privately and retain across server restarts; never commit its value.
MODEL_SETTINGS_ENCRYPTION_KEY=
