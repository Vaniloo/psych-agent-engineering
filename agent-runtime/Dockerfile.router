FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
# CPU service for Compose; GPU training uses the data-disk environment on lab.
RUN pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml README.md ./
COPY psych_agent_runtime ./psych_agent_runtime
RUN pip install '.[routing]'
CMD ["uvicorn", "psych_agent_runtime.routing_service:app", "--host", "0.0.0.0", "--port", "8091"]
